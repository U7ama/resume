{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Resume Studio AWS origin: CV app, private version history and bounded Qwen generation. Cloudflare provides HTTPS routing.",
  "Metadata": {
    "com.aws.cloudformation.Context": {
      "Purpose": "Personal CV workspace",
      "Database": "DynamoDB Standard provisioned 5 RCU/10 WCU; immutable revisions; retained on deletion",
      "Secrets": "Private encrypted S3 runtime configuration, readable only by the Lambda role",
      "Origin": "Lambda Function URL with an application-verified shared secret from the Cloudflare proxy",
      "Cost": "Shared monthly Lambda/DynamoDB allowances; tiny S3 deployment/configuration storage and request costs may remain. No always-on compute."
    }
  },
  "Resources": {
    "History": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "BillingMode": "PROVISIONED",
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 5,
          "WriteCapacityUnits": 10
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resume-studio"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ResumeRecords",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:TransactWriteItems"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "History",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": "arn:aws:s3:::resume-studio-129631621612-us-east-1/private/runtime.json"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-api:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "Api": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ApiLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.13",
        "Handler": "app.handler",
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 65,
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "S3Bucket": "resume-studio-129631621612-us-east-1",
          "S3Key": "deploy/api-5b77e67cee697ec18d8f.zip"
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "History"
            },
            "CONFIG_BUCKET": "resume-studio-129631621612-us-east-1"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resume-studio"
          }
        ]
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Api"
        },
        "AuthType": "NONE"
      }
    },
    "AllowUrl": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Api"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "AllowInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Api"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "OriginUrl": {
      "Description": "AWS origin (requires the private proxy header)",
      "Value": {
        "Fn::GetAtt": [
          "ApiUrl",
          "FunctionUrl"
        ]
      }
    },
    "HistoryTable": {
      "Description": "Retained private CV version history",
      "Value": {
        "Ref": "History"
      }
    },
    "ApiFunction": {
      "Description": "Application function name",
      "Value": {
        "Ref": "Api"
      }
    }
  }
}
